// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  EMAIL
  CALL
  MEETING
  TASK
  NOTE
  CAMPAIGN
  STATUS_CHANGE
  CUSTOM
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum SequenceStepType {
  EMAIL
  CALL
  LINKEDIN
  TASK
  WAIT
}

// ==================== MODELS ====================

model Organization {
  id        String   @id @default(cuid())
  clerkId   String?  @unique
  name      String
  slug      String   @unique
  logo      String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    OrganizationMember[]
  companies  Company[]
  contacts   Contact[]
  leads      Lead[]
  campaigns  Campaign[]
  activities Activity[]

  @@map("organizations")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  activities  Activity[]
  notes       Note[]

  @@map("users")
}

model OrganizationMember {
  id        String   @id @default(cuid())
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Company {
  id          String       @id @default(cuid())
  name        String
  domain      String?
  website     String?
  industry    String?
  size        CompanySize?
  revenue     Float?
  country     String?
  city        String?
  description String?
  linkedin    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contacts   Contact[]
  leads      Lead[]
  activities Activity[]

  @@map("companies")
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  linkedin  String?
  twitter   String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  leads      Lead[]
  activities Activity[]
  notes      Note[]

  @@map("contacts")
}

model Lead {
  id        String     @id @default(cuid())
  status    LeadStatus @default(NEW)
  score     Int        @default(0)
  source    String?
  notes     String?
  value     Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  activities Activity[]

  @@map("leads")
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leads      Lead[]
  sequences  Sequence[]
  activities Activity[]

  @@map("campaigns")
}

model Sequence {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  steps SequenceStep[]

  @@map("sequences")
}

model SequenceStep {
  id        String           @id @default(cuid())
  order     Int
  type      SequenceStepType
  subject   String?
  body      String?
  waitDays  Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@map("sequence_steps")
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@map("activities")
}

model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  @@map("notes")
}